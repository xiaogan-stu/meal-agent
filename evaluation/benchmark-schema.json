{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.diet-agent/evaluation/benchmark-schema.json",
  "title": "今日宜食会话评测用例",
  "type": "object",
  "required": ["caseId", "category", "sourceMode", "turns"],
  "properties": {
    "caseId": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "sourceMode": {"enum": ["PUBLIC", "PERSONAL"]},
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["message", "expectedIntent", "expectedSlots", "evaluateSlots"],
        "properties": {
          "message": {"type": "string", "minLength": 1},
          "expectedIntent": {
            "enum": [
              "MEAL_RECOMMENDATION",
              "CLARIFY_NEEDED",
              "MEAL_ADJUST",
              "MEAL_PLAN",
              "HEALTH_RISK",
              "OTHER"
            ]
          },
          "expectedSlots": {
            "type": "object",
            "properties": {
              "mealTime": {"$ref": "#/$defs/stringArray"},
              "mood": {"$ref": "#/$defs/stringArray"},
              "scene": {"$ref": "#/$defs/stringArray"},
              "healthGoal": {"$ref": "#/$defs/stringArray"},
              "cuisine": {"$ref": "#/$defs/stringArray"},
              "taste": {"$ref": "#/$defs/stringArray"},
              "convenience": {"$ref": "#/$defs/stringArray"}
            },
            "additionalProperties": false
          },
          "expectedClarifyAction": {"type": ["string", "null"], "enum": ["ASK", "READY", null]},
          "evaluateSlots": {"type": "boolean"},
          "acceptableMealIds": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
